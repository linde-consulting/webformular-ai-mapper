# Eigener Anthropic-API-Key für das semantische Feld-Matching.
# Ohne Key läuft die Pipeline im regelbasierten Fallback-Modus (String-Ähnlichkeit).
ANTHROPIC_API_KEY=

# Optional: alternatives Matching-Modell.
AI_MAPPER_MODEL=claude-sonnet-4-5

# Basis-URL der FIM-Portal-API (i.d.R. nicht ändern).
FIM_API_BASE=https://fimportal.de
